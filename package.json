{
  "name": "dsh-agent-browser",
  "version": "0.1.0",
  "description": "DeepSeek Harness browser automation tools backed by Vercel agent-browser",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Lin-A1/dsh-agent-browser.git" },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib/", "cordis.patch.yml", "README.md", "AGENTS.md"],
  "scripts": {
    "build": "tsdown",
    "prepare": "corepack pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "test": "vitest run"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^22.10.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
